# Azure AI Foundry project endpoint, e.g.
# https://<your-project>.<region>.api.azureml.ms or the "Foundry project endpoint"
# shown on the project Overview page in ai.azure.com
PROJECT_ENDPOINT=

# Name of the model deployment (in your Foundry project) the agent should run on,
# e.g. gpt-4o, gpt-4.1-mini
MODEL_DEPLOYMENT_NAME=

# Reasoning effort passed to the model for the AI plausibility-judgment layer.
REASONING_EFFORT=low
