# Copy to .env for local container runs against the Foundry gateway
# (python foundry_app.py), or set these as the Hosted Agent's environment
# variables via azure.yaml / `azd env set` for a deployed run.

# Azure AI Foundry project endpoint, e.g.
# https://<your-project>.<region>.api.azureml.ms or the "Foundry project endpoint"
# shown on the project Overview page in ai.azure.com
PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Must match your Foundry *model deployment name* (not a generic model family name):
MODEL_DEPLOYMENT_NAME=gpt-4o
REASONING_EFFORT=low

# Auth for DefaultAzureCredential is provided by the hosted agent's managed
# identity in Foundry; locally use `az login` or set
# AZURE_CLIENT_ID/AZURE_TENANT_ID/AZURE_CLIENT_SECRET for a service principal.

# Blob storage backend -- lets requests pass a bare "<container>/<blob>" path
# (e.g. "fmg-inbound/NEO.csv") as input/reference, and writes the validated
# CSV back to the matching "*-outbound" container automatically (see
# src/storage.py). Leave STORAGE_BACKEND unset/"local" to read/write local
# files instead (the CLI's default).
STORAGE_BACKEND=azure_blob
OUTPUT_CONTAINER=outputs
# Set ONE of these to authenticate against the storage account:
AZURE_STORAGE_CONNECTION_STRING=<your storage connection string>
AZURE_STORAGE_ACCOUNT_URL=<https://<account>.blob.core.windows.net>

